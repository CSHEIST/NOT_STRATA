
#!/usr/bin/env python3

import math
import os
import socket
import time

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState


ESP32_IP = os.environ.get("ESP32_IP", "10.148.36.252").strip()
ESP32_PORT = 4210

BASE = "base_joint"
SHOULDER = "shoulder_joint"
ELBOW = "elbow_joint"
WRIST = "wrist_joint"
GRIPPER = "gripper_joint"
CLAW = "gripper_command_joint"

BASE_LIMIT = 1.279
SHOULDER_LIMIT = 1.5708
ELBOW_LIMIT = 1.5708
WRIST_LIMIT = 1.5708
GRIPPER_LIMIT = 1.5708

CLAW_DEADZONE = 0.15


def clamp(value, low, high):
    return max(low, min(high, value))


def base_to_servo(rad):
    return clamp(90.0 + rad / BASE_LIMIT * 80.0, 10.0, 170.0)


def shoulder_to_servo(rad):
    return clamp(
        94.5 + rad / SHOULDER_LIMIT * 77.5,
        17.0, 172.0
    )


def elbow_to_servo(rad):
    # Reversed direction: positive URDF angle decreases servo angle.
    return clamp(
        90.0 - rad / ELBOW_LIMIT * 30.0,
        60.0, 120.0
    )


def wrist_to_servo(rad):
    # Wrist: 120-degree center; 80-160-degree range.
    return clamp(
        120.0 + rad / WRIST_LIMIT * 40.0,
        80.0, 160.0
    )


def gripper_to_servo(rad):
    # Gripper orientation: provisional 90-degree center.
    return clamp(
        90.0 + rad / GRIPPER_LIMIT * 30.0,
        60.0, 120.0
    )


class ArmESP32Bridge(Node):

    def __init__(self):
        super().__init__("arm_esp32_bridge")

        self.udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.last_sent = None
        self.last_claw_zone = 0
        self.last_log_time = 0.0

        self.subscription = self.create_subscription(
            JointState,
            "/joint_states",
            self.joint_state_callback,
            10
        )

        self.get_logger().info("Six-function arm bridge started")
        self.get_logger().info(
            f"ESP32 target: {ESP32_IP}:{ESP32_PORT}"
        )
        self.get_logger().info(
            "Claw slider: negative=CLOSE, positive=OPEN, center=NO COMMAND"
        )

    def joint_state_callback(self, msg):
        joints = dict(zip(msg.name, msg.position))

        required = (BASE, SHOULDER, ELBOW, WRIST, GRIPPER, CLAW)
        if not all(name in joints for name in required):
            return

        if not all(math.isfinite(joints[name]) for name in required):
            self.get_logger().warning("Invalid joint values; ignored.")
            return

        base = base_to_servo(joints[BASE])
        shoulder = shoulder_to_servo(joints[SHOULDER])
        elbow = elbow_to_servo(joints[ELBOW])
        wrist = wrist_to_servo(joints[WRIST])
        gripper = gripper_to_servo(joints[GRIPPER])

        values = (base, shoulder, elbow, wrist, gripper)

        # Interpret the virtual claw slider by zones.
        claw_position = joints[CLAW]
        if claw_position > CLAW_DEADZONE:
            claw_zone = 1
        elif claw_position < -CLAW_DEADZONE:
            claw_zone = -1
        else:
            claw_zone = 0

        claw_command = "NONE"
        if claw_zone != self.last_claw_zone:
            if claw_zone == 1:
                claw_command = "OPEN"
            elif claw_zone == -1:
                claw_command = "CLOSE"

            self.last_claw_zone = claw_zone

        if self.last_sent is not None:
            unchanged = all(
                abs(a - b) < 0.2
                for a, b in zip(values, self.last_sent)
            )
            if unchanged and claw_command == "NONE":
                return

        # These field names must match the ESP32 firmware.
        packet = (
            f"BASE:{base:.1f},"
            f"SHOULDER:{shoulder:.1f},"
            f"ELBOW:{elbow:.1f},"
            f"WRIST:{wrist:.1f},"
            f"GRIPPER:{gripper:.1f},"
            f"CLAW:{claw_command}"
        )

        try:
            self.udp.sendto(
                packet.encode("utf-8"),
                (ESP32_IP, ESP32_PORT)
            )
            self.last_sent = values

            now = time.monotonic()
            if claw_command != "NONE" or now - self.last_log_time >= 1.0:
                self.get_logger().info(f"UDP sent: {packet}")
                self.last_log_time = now

        except OSError as error:
            self.get_logger().error(f"UDP send failed: {error}")

    def destroy_node(self):
        self.udp.close()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = ArmESP32Bridge()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
